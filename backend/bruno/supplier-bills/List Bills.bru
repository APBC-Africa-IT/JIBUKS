meta {
  name: List Bills
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/supplier-bills?limit=20
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
}

docs {
  Requires supplier_bills:view. Filters: status (incl. OVERDUE, and DUE = posted, owed, not overdue), q
  (supplier name, number, reference, supplier invoice no.), kind (BILL, DEBIT_NOTE), supplier_id, from, to.
  e.g. ?status=DUE&q=unga
}
