meta {
  name: Get Tenant
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/tenant
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
}

docs {
  The caller's own business. Any signed-in user. plan_tier STARTER = micro-trader
  (offer Owner, Cashier, Agent only); GROWTH / ENTERPRISE = all roles + custom roles.
  system_accounts maps each purpose (RECEIVABLE, PAYABLE, VAT_INPUT, VAT_OUTPUT, CASH, BANK, MPESA,
  OPENING_BALANCE) to its account id, or null -- find accounts here, never by code.
}
