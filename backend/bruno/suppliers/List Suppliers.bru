meta {
  name: List Suppliers
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/suppliers
  body: none
  auth: none
}

params:query {
  ~as_of: 2026-08-31
  ~q: acme
  ~supplier_type_id: {{supplierTypeId}}
}

headers {
  Authorization: Bearer {{authToken}}
}

docs {
  Each supplier has code, last_activity, balance_minor, overdue_minor and payment_status (OVERDUE / DUE / CREDIT / SETTLED) for the list's "(Overdue)" / "(Due)" tag. q matches name, code, phone or email.
}
