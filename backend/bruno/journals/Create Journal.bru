meta {
  name: Create Journal
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/journals
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
  Content-Type: application/json
}

body:json {
  {
    "clientUuid": "{{$randomUUID}}",
    "date": "2026-09-15",
    "currency": "KES",
    "description": "Cash sale",
    "source": "CASHBOOK",
    "lines": [
      { "accountId": "{{cashAccountId}}", "debitMinor": 100000, "creditMinor": 0 },
      { "accountId": "{{salesAccountId}}", "debitMinor": 0, "creditMinor": 100000 }
    ]
  }
}
docs {
  Requires journals:create. The Journal Entry screen. The response's number (JE-000001, gapless) is the Ref#;
  reference stays free text. May come back PENDING_APPROVAL if the business requires approval for this size.
}
