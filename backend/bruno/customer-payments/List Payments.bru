meta {
  name: List Payments
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/customer-payments
  body: none
  auth: none
}

params:query {
  ~customer_id: 00000000-0000-4000-8000-000000000000
  ~method: MPESA
  ~from: 2026-10-01
  ~to: 2026-10-31
  ~has_credit: true
  ~q: jane
  ~limit: 50
}

headers {
  Authorization: Bearer {{authToken}}
}
