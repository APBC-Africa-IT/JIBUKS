meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
  Content-Type: application/json
}

body:json {
  {
    "externalIdpSubject": "auth0|{{$randomUUID}}",
    "name": "Teammate",
    "email": "teammate@example.com"
  }
}