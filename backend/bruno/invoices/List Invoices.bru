meta {
  name: List Invoices
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/invoices?limit=20
  body: none
  auth: none
}

params:query {
  ~kind: PROFORMA
  ~estimate_status: PENDING
  ~q: jane
}

headers {
  Authorization: Bearer {{authToken}}
}

docs {
  Requires invoices:view. Newest first. Filters: status (incl. OVERDUE), kind, estimate_status (estimates), customer_id, from, to, q (search).
  When has_more is true, pass next_cursor as ?cursor= for the next page.
}
