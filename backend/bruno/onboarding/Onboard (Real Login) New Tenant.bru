meta {
  name: Onboard (Real Login) New Tenant 
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/onboarding
  body: json
  auth: oauth2
}

auth:oauth2 {
  grant_type: authorization_code
  callback_url: https://usebruno.com/oauth2/callback
  authorization_url: https://dev-1g8zdrubzj5enqii.us.auth0.com/authorize
  access_token_url: https://dev-1g8zdrubzj5enqii.us.auth0.com/oauth/token
  refresh_token_url: 
  client_id: SxX6IvVhmgGeLW3gREuRf28VtLrnW93k
  client_secret: 
  scope: openid profile email
  state: 
  pkce: false
  credentials_placement: body
  credentials_id: credentials
  token_source: access_token
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}

auth:oauth2:additional_params:auth_req:queryparams {
  audience: https://apbc.jibuks.com
}

body:json {
  {
    "tenantName": "Real Login Test Business",
    "tenantType": "BUSINESS",
    "baseCurrency": "KES",
    "userName": "Real Login Test Owner"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
